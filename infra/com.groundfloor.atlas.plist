<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.groundfloor.atlas.plist — LaunchAgent template for Atlas.

  NOT installed automatically. To install after building:

    cp infra/com.groundfloor.atlas.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.groundfloor.atlas.plist

  Adjust paths under ProgramArguments / WorkingDirectory if you check
  the repo out somewhere other than the default sibling location.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.groundfloor.atlas</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ATLAS_HOME</key>
        <string>__HOME__/.groundfloor/atlas</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__REPO_ROOT__/dist/daemon.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/Atlas/atlas.out</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/Atlas/atlas.log</string>
</dict>
</plist>
