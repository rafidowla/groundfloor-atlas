{
  "name": "@groundfloor/atlas",
  "version": "0.2.8",
  "description": "Groundfloor Atlas — standalone code-intelligence daemon. Tree-sitter parser + cross-file resolver + graph analytics. X4 exposes 7 code-intelligence MCP tools (call_graph, find_dead_code, blast_radius, schema_drift, layer_violations, hotspots, index) on Groundfloor Atlas's MCP server at port 3848.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/daemon.js",
  "bin": {
    "atlas": "bin/atlas",
    "groundfloor-atlas": "bin/atlas",
    "lorebase": "bin/atlas"
  },
  "files": [
    "dist/",
    "atlas-ui/dist/",
    "bin/",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "docs/tool-schemas.json"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/restart-daemon.mjs",
    "dev": "tsx src/daemon.ts",
    "serve": "tsx src/daemon.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx tests/health.test.ts",
    "test:e2e": "tsx tests/e2e.test.ts",
    "test:x3": "tsx tests/x3.test.ts",
    "test:x4": "tsx tests/x4.test.ts",
    "guard": "tsx scripts/guard.ts",
    "guard:watch": "tsx scripts/guard.ts --watch",
    "schemas:dump": "tsx scripts/dump-tool-schemas.ts",
    "schemas:check": "tsx scripts/dump-tool-schemas.ts --check",
    "test:y3": "tsx tests/y3.test.ts",
    "test:y-perf": "tsx tests/y-perf.test.ts",
    "test:embedded": "tsx tests/embedded.test.ts",
    "test:embedded-read": "tsx tests/embedded-read.test.ts",
    "test:memory-edges": "tsx tests/memory-edges.test.ts",
    "test:memory-portability": "tsx tests/memory-portability.test.ts",
    "test:groups": "tsx tests/groups.test.ts",
    "test:repo-id": "tsx tests/repo-id.test.ts",
    "test:symbol-id": "tsx tests/symbol-id-safety.test.ts",
    "test:tags": "tsx tests/tags.test.ts",
    "test:checkpoint": "tsx tests/checkpoint.test.ts",
    "test:group-yaml": "tsx tests/group-yaml.test.ts",
    "test:service": "tsx tests/service.test.ts",
    "test:sprint3": "tsx tests/sprint3.test.ts",
    "test:sprint4": "tsx tests/sprint4.test.ts",
    "test:gf1": "tsx tests/gf1.test.ts",
    "test:gf2": "tsx tests/gf2.test.ts",
    "test:gf3": "tsx tests/gf3.test.ts",
    "test:gf4": "tsx tests/gf4.test.ts",
    "test:g3": "tsx tests/g3.test.ts",
    "test:b3a": "tsx tests/b3a-stream.test.ts",
    "test:b3a-cloud": "tsx tests/b3a-cloud-stream.test.ts",
    "bundle": "node scripts/bundle.mjs",
    "test:httptransport": "tsx tests/httptransport.test.ts",
    "test:index-roots": "tsx tests/index-roots.test.ts",
    "test:config-port": "tsx tests/config-port.test.ts",
    "test:memory-merge": "tsx tests/memory-merge-driver.test.ts",
    "test:recall-roundtrip": "tsx tests/recall-roundtrip.test.ts",
    "test:recall-modes": "tsx tests/recall-modes.test.ts",
    "test:recall-search-isolation": "tsx tests/recall-search-isolation.test.ts",
    "test:verbatim": "tsx tests/verbatim.test.ts",
    "test:close-lock": "tsx tests/close-lock-timeout.test.ts",
    "test:index-parity": "tsx tests/index-parity.test.ts",
    "test:incremental-single-file": "tsx tests/incremental-single-file.test.ts",
    "test:mcp-index-reconcile-scope": "tsx tests/mcp-index-reconcile-scope.test.ts",
    "test:scale": "tsx tests/scale-integrity.test.ts",
    "test:rc-integrity": "tsx tests/rc-integrity.test.ts",
