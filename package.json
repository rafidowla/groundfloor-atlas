    "test:rc-security": "tsx tests/rc-security.test.ts",
    "test:rc-scale-bounds": "tsx tests/rc-scale-bounds.test.ts",
    "test:rc-hardening": "tsx tests/rc-hardening.test.ts",
    "test:audit-high": "tsx tests/audit-high-severity.test.ts",
    "test:audit-medium": "tsx tests/audit-medium.test.ts",
    "test:graph-handlers": "tsx tests/graph-handler-attribution.test.ts",
