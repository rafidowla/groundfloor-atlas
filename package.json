    "test:file-mode": "tsx tests/file-mode.test.ts",
    "test:hook-client": "tsx tests/hook-client.test.ts",
    "test:hook-enrich": "tsx tests/hook-enrich.test.ts",
    "test:hook-workspace-resolution": "tsx tests/hook-workspace-resolution.test.ts",
    "test:global-wire": "tsx tests/global-wire.test.ts",
    "test:global-wire-uninstall": "tsx tests/global-wire-uninstall.test.ts",
    "test:wire-tools-status": "tsx tests/wire-tools-status.test.ts",
    "test:ide-connect-codex": "tsx tests/ide-connect-codex.test.ts",
    "test:ide-connect-vscode": "tsx tests/ide-connect-vscode.test.ts",
    "test:onboard": "tsx tests/onboard.test.ts",
    "test:background-onboard": "tsx tests/background-onboard.test.ts",
    "test:project-tier": "tsx tests/project-tier.test.ts",
    "test:e2e-autowire": "tsx tests/e2e-autowire.test.ts",
    "test:all": "tsc --noEmit && node scripts/run-all-tests.mjs",
    "check:license": "node scripts/check-license-headers.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:node-abi": "node scripts/check-node-abi.mjs",
    "vendor:node": "node scripts/vendor-node.mjs",
    "build:ui": "cd atlas-ui && npm ci && npm run build",
    "package": "npm run build && npm run build:ui && npm pack",
    "prepack": "npm run build && npm run build:ui"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@groundfloor/lore": "file:vendor/groundfloor-lore-3.16.0.tgz",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-pagerank": "^1.1.0",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
